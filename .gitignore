# Промежуточные файлы theos.
.theos/

# Готовые пакеты. Собираются из исходников одной командой, и класть их
# в историю значило бы носить по паре сотен килобайт двоичного файла
# на каждую правку.
packages/*.deb
packages/*.ipa

# Копия cYclients, которую снимает Makefile перед сборкой. Источник истины —
# соседний репозиторий; здесь лежит только слепок, и версия ему не нужна.
vendor/

# Токен партнёра приезжает сюда вместе с копией библиотеки. Он выдан
# на конкретную учётную запись разработчика YClients и в общий доступ
# не идёт — по нему опознаются все запросы приложения.
partner_token.h

# Штамп времени сборки. Пишется Makefile при каждом запуске и меняется
# сам по себе — в истории от него был бы один шум.
src/model/YCBuildStamp.h

.DS_Store
*~
